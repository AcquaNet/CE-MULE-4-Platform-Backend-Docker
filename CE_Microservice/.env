# Mule Platform Environment Configuration
# Auto-generated for 2-worker deployment

# Mule Runtime Configuration
mule_env=local-docker
muleVersion=4.4.0
versionMule=4.4.0

# Mule Application Maven Coordinates
MULEAPP_GROUP_ID=com.acqua
MULEAPP_ARTIFACT_ID=ce-mule-base
MULEAPP_VERSION=1.0.9

# Artifact Repository Configuration
ATINA_REPOSITORY_PROTOCOL=http
ATINA_REPOSITORY_URL=http://jfrog.atina-connection.com:8081/artifactory/libs-release

# APM Server Configuration
APM_SECRET_TOKEN=ZI5YVL1uP1Vw60iNj3LPXdpiekJnJm4FrbkoJRMO9RU=
LOGSTASH_AUTH_TOKEN=8fcrQrMcOyWbn6nJdoFzkTpXQGyOHMJw7qcfUotk2v8=

# Port Configuration (not exposed externally when using APISIX)
MULE_HTTP_PORT=8081
MULE_HTTPS_PORT=8082

# ActiveMQ Configuration
versionApacheMQ=5.15.3
MULE_MQ_WEB_CONSOL_PORT=8161
MULE_MQ_AMQP_PORT=5672
MULE_MQ_OPENWIRE_PORT=61616

# Maven Service Configuration
versionMaven=3.6.3

# Status Viewer Configuration
versionStatusViewer=1.0
API_STATUS_URL=http://ce-base-mule-backend-1:8081/api/v1/status

# MySQL Database Configuration
MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=ce_backend_db
MYSQL_USER=ce_user
MYSQL_PASSWORD=ce_password
MYSQL_EXTERNAL_PORT=3306
MYSQL_INTERNAL_PORT=3306
MYSQL_FILE_CONFIG=/etc/mysql/conf.d
MYSQL_DATA=/var/lib/mysql

# Volume Paths - Using project-local volumes directory
FOLDER_ROOT=/opt/backend/home

# Shared volumes (used by both workers)
Volume_CE_base_BackendHome=/mnt/c/work/Aqua/Docker ElasticSearch/git/CE-MULE-4-Platform-Backend-Docker/CE_Microservice/volumes/home
Volume_CE_base_BackendActiveMQConf=/mnt/c/work/Aqua/Docker ElasticSearch/git/CE-MULE-4-Platform-Backend-Docker/CE_Microservice/volumes/activemq-conf
Volume_CE_base_BackendActiveMQData=/mnt/c/work/Aqua/Docker ElasticSearch/git/CE-MULE-4-Platform-Backend-Docker/CE_Microservice/volumes/activemq-data

# Worker 1 volumes (dedicated to worker 1)
Volume_CE_base_BackendMuleLog1=/mnt/c/work/Aqua/Docker ElasticSearch/git/CE-MULE-4-Platform-Backend-Docker/CE_Microservice/volumes/worker1/logs
Volume_CE_base_BackendMuleApps1=/mnt/c/work/Aqua/Docker ElasticSearch/git/CE-MULE-4-Platform-Backend-Docker/CE_Microservice/volumes/worker1/apps

# Worker 2 volumes (dedicated to worker 2)
Volume_CE_base_BackendMuleLog2=/mnt/c/work/Aqua/Docker ElasticSearch/git/CE-MULE-4-Platform-Backend-Docker/CE_Microservice/volumes/worker2/logs
Volume_CE_base_BackendMuleApps2=/mnt/c/work/Aqua/Docker ElasticSearch/git/CE-MULE-4-Platform-Backend-Docker/CE_Microservice/volumes/worker2/apps

# Database volumes
Volume_CE_base_BackendDBBackendConfig=/mnt/c/work/Aqua/Docker ElasticSearch/git/CE-MULE-4-Platform-Backend-Docker/CE_Microservice/volumes/mysql-conf
Volume_CE_base_BackendDBBackendData=/mnt/c/work/Aqua/Docker ElasticSearch/git/CE-MULE-4-Platform-Backend-Docker/CE_Microservice/volumes/mysql-data

# Maven repository cache (shared)
Volume_CE_base_BackendMavenRepository=/mnt/c/work/Aqua/Docker ElasticSearch/git/CE-MULE-4-Platform-Backend-Docker/CE_Microservice/volumes/maven-repo
