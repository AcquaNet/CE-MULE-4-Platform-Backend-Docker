# ./.env 
# for our staging environment
#
# ====================================
# DOCKER VERSION
# ====================================
#
versionMule=1.0.0
versionMaven=1.0.0
versionApacheMQ=1.0.0
versionStatusViewer=1.0.0
#
# ====================================
# REPOSITORY
# ====================================
#
# Repositorio usado para descarga
# de las aplicaciones de Atina y Mule
#
ATINA_REPOSITORY_PROTOCOL=http
ATINA_REPOSITORY_URL=jfrog.atina-connection.com/artifactory/libs-release
#
#
# ====================================
# MULE MICROSERVER SERVER
# ====================================
# mule_env
#   La variable mule_env es la variable usada por la aplicacion Mule para
#   saber que configuración de propiedades usar ${mule_env}.properties
# muleVersion
#   Determina que version de Mule standalone se esta usando
#   mule-standalone-${muleVersion}
# MULEAPP_GROUP_ID/MULEAPP_ARTIFACT_ID/MULEAPP_VERSION
#   Aplication que sera ejecutada por Mulesoft
#   Se descarga del JFROG en mule-start.sh
#
mule_env=local-docker
#
muleVersion=4.4.0
#
MULEAPP_GROUP_ID=com.acqua
MULEAPP_ARTIFACT_ID=ce-mule-base
MULEAPP_VERSION=1.0.0
#
# ====================================
# Puertos Mule MICROSERVER
# ====================================
#
MULE_HTTP_PORT=8081
MULE_HTTPS_PORT=8082
#
# ====================================
# Puertos Apache
# ====================================
#
MULE_MQ_WEB_CONSOL_PORT=8161
MULE_MQ_AMQP_PORT=5672
MULE_MQ_OPENWIRE_PORT=8162
#
# ====================================
# DB SERVER
# ====================================
#
MYSQL_ROOT_PASSWORD=CEBase2026!
MYSQL_EXTERNAL_PORT=3308
MYSQL_INTERNAL_PORT=3306
#
# ====================================
# INTERNAL CONFIGURACION
# ====================================
#
MYSQL_FILE_CONFIG=/etc/mysql/conf.d
MYSQL_DATA=/var/lib/mysql
#
# ====================================
# DB CONFIGURATION
# ====================================
#
MYSQL_DATABASE=ce_base
#
# ====================================
# USER ADMIN
# ====================================
#
MYSQL_USER=admin
MYSQL_PASSWORD=CEBase2026!
#
# ====================================
# STATUS VIEWER
# ====================================
# 
API_STATUS_URL=https://172.41.0.2:8082/api/v1/status
#
# ====================================
# Volume Root
# ====================================
#
FOLDER_ROOT=/Users/franciscogodinoconte/_AcquaIT/CE-Platform/volumes
#
# References:
#
Volume_CE_base_BackendHome=${FOLDER_ROOT}/backend
Volume_CE_base_BackendActiveMQConf=${FOLDER_ROOT}/backend/activeMQ/conf
Volume_CE_base_BackendActiveMQData=${FOLDER_ROOT}/backend/activeMQ/data
Volume_CE_base_BackendMuleLog=${FOLDER_ROOT}/backend/mule/logs
Volume_CE_base_BackendMuleApps=${FOLDER_ROOT}/backend/mule/apps
Volume_CE_base_BackendDBBackendConfig=${FOLDER_ROOT}/backend/mysql/conf
Volume_CE_base_BackendDBBackendData=${FOLDER_ROOT}/backend/mysql/data
Volume_CE_base_BackendMavenRepository=${FOLDER_ROOT}/backend/maven/repository
#
#