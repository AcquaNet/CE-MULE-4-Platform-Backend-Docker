# Mule Platform Environment Configuration
# Copy this file to .env and update with your values

# Mule Runtime Configuration
mule_env=local-docker
muleVersion=4.4.0
versionMule=4.4.0

# Mule Application Maven Coordinates
MULEAPP_GROUP_ID=com.acqua
MULEAPP_ARTIFACT_ID=ce-mule-base
MULEAPP_VERSION=1.0.8

# Artifact Repository Configuration
ATINA_REPOSITORY_PROTOCOL=http
ATINA_REPOSITORY_URL=http://jfrog.atina-connection.com:8081/artifactory/libs-release

# Port Configuration (not exposed externally when using APISIX)
MULE_HTTP_PORT=8081
MULE_HTTPS_PORT=8082

# ActiveMQ Configuration
versionApacheMQ=5.15.3
MULE_MQ_WEB_CONSOL_PORT=8161
MULE_MQ_AMQP_PORT=5672
MULE_MQ_OPENWIRE_PORT=61616

# Maven Service Configuration
versionMaven=3.6.3

# Status Viewer Configuration
versionStatusViewer=1.0
API_STATUS_URL=http://ce-base-mule-backend-1:8081/api/v1/status

# MySQL Database Configuration
MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=ce_backend_db
MYSQL_USER=ce_user
MYSQL_PASSWORD=ce_password
MYSQL_EXTERNAL_PORT=3306
MYSQL_INTERNAL_PORT=3306
MYSQL_FILE_CONFIG=/etc/mysql/conf.d
MYSQL_DATA=/var/lib/mysql

# Volume Paths - Update these to match your host directory structure
# These paths should exist on your host machine

# Shared volumes (used by both workers)
FOLDER_ROOT=/opt/backend/home
Volume_CE_base_BackendHome=/path/to/backend/home
Volume_CE_base_BackendActiveMQConf=/path/to/activemq/conf
Volume_CE_base_BackendActiveMQData=/path/to/activemq/data

# Worker 1 volumes (dedicated to worker 1)
Volume_CE_base_BackendMuleLog1=/path/to/mule/logs/worker1
Volume_CE_base_BackendMuleApps1=/path/to/mule/apps/worker1

# Worker 2 volumes (dedicated to worker 2)
Volume_CE_base_BackendMuleLog2=/path/to/mule/logs/worker2
Volume_CE_base_BackendMuleApps2=/path/to/mule/apps/worker2

# Database volumes
Volume_CE_base_BackendDBBackendConfig=/path/to/mysql/conf
Volume_CE_base_BackendDBBackendData=/path/to/mysql/data

# Maven repository cache (shared)
Volume_CE_base_BackendMavenRepository=/path/to/maven/repository

# Notes:
# 1. Worker 1 and Worker 2 have separate log and apps directories for isolation
# 2. Both workers share the same home directory and ActiveMQ configuration
# 3. Access to Mule workers is via APISIX gateway at http://your-server:9080/api/*
# 4. Direct worker access for debugging:
#    - Worker 1: http://ce-base-mule-backend-1:8081 (internal network only)
#    - Worker 2: http://ce-base-mule-backend-2:8081 (internal network only)
